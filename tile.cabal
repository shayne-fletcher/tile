cabal-version:      3.0
name:               tile
version:            0.1.0.0
synopsis:           Structured collective communication
description:        A small library for structuring collective communication as tilings, schedules, and executions over explicit rank-space topology.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Shane Fletcher
maintainer:         shayne@shaynefletcher.org
tested-with:        GHC == 9.14.1
-- copyright:
category:           System
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    article/bounded-fanout.md
    article/routing-foundations.md
    article/routing-theorems.md
-- extra-source-files:

source-repository head
    type:     git
    location: https://github.com/shayne-fletcher/tile.git

common warnings
    ghc-options: -Wall

library
    import:           warnings

    exposed-modules:
      Tile
      Tile.Collective
      Tile.Shape
      Tile.Tile
      Tile.Tiling
      Tile.Schedule
      Tile.Routing
      Tile.Execution
      Tile.Execution.Concurrent
      Tile.Neighborhood
      Tile.Geometry
      Tile.Affine
      Tile.Tree

    -- other-modules:
    -- other-extensions:

    build-depends:    base ^>=4.22.0.0
                    , containers >=0.8 && <0.9
    hs-source-dirs:   src
    default-language: GHC2024

executable tile-demo
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.18 && <4.23,
      containers >=0.8 && <0.9,
      tile
  default-language: GHC2024

test-suite tile-test
    import:           warnings
    default-language: GHC2024
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.22.0.0,
        containers >=0.8 && <0.9,
        tile,
        tasty >=1.4,
        tasty-hunit >=0.10,
        tasty-quickcheck >=0.10
